{
  "runOnSave.defaultRunIn": "backend",
  "runOnSave.ignoreFilesBy": [
    ".gitignore"
  ],
  "runOnSave.commands": [
    {
      "match": "\\.ya?ml$",
      "command": "task --silent --exit-code --dir \"${workspaceFolder}\" fmt:yaml -- \"${file}\"",
      "async": false,
      "notMatch": "(^|[\\\\/])(\\.git|\\.idea|\\.vscode|\\.tools|\\.build|node_modules)([\\\\/]|$)|(^|[\\\\/])\\.github[\\\\/]workflows[\\\\/][^\\\\/]*\\.lock\\.yml$|(^|[\\\\/])etc[\\\\/]\\.mise[\\\\/]locks[\\\\/]"
    },
    {
      "match": "\\.json$",
      "command": "task --silent --exit-code --dir \"${workspaceFolder}\" fmt:json -- \"${file}\"",
      "async": false,
      "notMatch": "(^|[\\\\/])(\\.git|\\.idea|\\.vscode|\\.tools|\\.build|node_modules)([\\\\/]|$)|(^|[\\\\/])package-lock\\.json$"
    },
    {
      "match": "\\.go$",
      "command": "task --silent --exit-code --dir \"${workspaceFolder}\" fmt:go -- \"${file}\"",
      "async": false,
      "notMatch": "(^|[\\\\/])(\\.git|\\.idea|\\.vscode|\\.tools|\\.build|node_modules)([\\\\/]|$)"
    },
    {
      "match": "\\.go$",
      "command": "task --silent --exit-code --dir \"${workspaceFolder}\" lint:go -- \"./${fileDirnameRelative}\"",
      "async": false,
      "notMatch": "(^|[\\\\/])(\\.git|\\.idea|\\.vscode|\\.tools|\\.build|node_modules)([\\\\/]|$)"
    },
    {
      "match": "\\.toml$",
      "command": "task --silent --exit-code --dir \"${workspaceFolder}\" fmt:toml -- \"${file}\"",
      "async": false,
      "notMatch": "(^|[\\\\/])(\\.git|\\.idea|\\.vscode|\\.tools|\\.build|node_modules)([\\\\/]|$)"
    }
  ]
}
